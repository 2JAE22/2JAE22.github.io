source 'https://rubygems.org'

gem 'jekyll', '4.4.1'  # 최신 Jekyll 버전 사용
gem 'webrick'  # Jekyll 실행 시 필요한 서버 라이브러리
# Windows 환경에서 파일 변경 감지를 최적화
gem 'wdm', '>= 0.1.0' if Gem.win_platform?
gem "tzinfo"
gem "tzinfo-data"


group :jekyll_plugins do
  gem 'jekyll-paginate'
  gem 'jekyll-sitemap'
  gem 'jekyll-feed'

end
